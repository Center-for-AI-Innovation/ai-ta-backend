# Logging & concurrency
LOG_LEVEL=INFO
MAX_WORKERS=8
XML_LOG_EVERY_N=100
TEST_LIMIT=0          # optional, 0=unlimited
PIPELINE_STATE_LOG=pipeline_state/pipeline_state.json  # Path to the process state log file

# Postgres (Supabase)
POSTGRES_DSN=postgresql://user:pass@host:5432/dbname
DB_SCHEMA=vyraid

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=...
MINIO_SECRET_KEY=...
MINIO_BUCKET=pubmed
MINIO_SECURE=false
FILE_LOCATION=oa_pdf_mirror   # optional prefix inside bucket

# Embeddings (Ollama or proxy exposing /embeddings-like API)
EMBEDDING_BASE_URL=http://localhost:11434/api/embeddings

# Qdrant
QDRANT_URL=http://localhost
QDRANT_PORT=6333
QDRANT_API_KEY=              
QDRANT_COLLECTION=ncbi_pdfs
VECTOR_SIZE=768
CHUNK_SIZE=1000 # Required by nomic-embed-text:v1.5; do not change without re-vectorizing
CHUNK_OVERLAP=200
EMBED_BATCH_UPSERT=125