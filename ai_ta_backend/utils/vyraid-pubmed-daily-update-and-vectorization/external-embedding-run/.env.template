# === Qdrant Cloud ===
QDRANT_URL=https://qdrant.ncsa.ai/
QDRANT_API_KEY=<your-qdrant-api-key>
QDRANT_COLLECTION=pubmed_v2
QDRANT_PORT=6333

# === MinIO ===
MINIO_ENDPOINT=https://minio-api.ncsa.ai/
MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>
MINIO_BUCKET=pubmed
MINIO_SECURE=True

# === Ollama Embedding ===
EMBEDDING_BASE_URL=http://localhost:11434/api/embeddings
# For multi-GPU round-robin, pass --embedding-urls on the command line instead:
#   --embedding-urls http://localhost:11434/api/embeddings http://localhost:11435/api/embeddings

# === Vectorization ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
VECTOR_SIZE=768

# === Supabase / Postgres (optional — only for --source supabase/both or --mark-supabase) ===
POSTGRES_DSN=postgresql://postgres:<password>@db.<ref>.supabase.co:6543/postgres
DB_SCHEMA=vyraid
