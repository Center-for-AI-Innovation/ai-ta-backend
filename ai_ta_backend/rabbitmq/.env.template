# ---------------------------------------------------------------------------
# RabbitMQ ingest worker environment template.
#
# The worker (worker.py) and producer (rmqueue.py) call load_dotenv(), so a
# `.env` in this directory is picked up when running `python worker.py` from
# ai_ta_backend/rabbitmq/. Copy this file to `.env` and fill in real values
# (the `.env` is gitignored). This is a subset of the backend .env — the
# defaults below are used when a project has no external connection; per-project
# overrides (bucket / qdrant / database / embedding) are resolved at runtime.
#
# RabbitMQ connection settings (RABBITMQ_URL, etc.) and tuning knobs with code
# defaults (MAX_JOB_RETRIES, RABBITMQ_PREFETCH_COUNT, QDRANT_UPSERT_BATCH_SIZE,
# EMBEDDING_MAX_ATTEMPTS) are supplied by the runtime/deployment, not here.
# ---------------------------------------------------------------------------

# ── Host documents DB (default for projects without database_config) ──
# Also holds ingest status (documents_in_progress / documents_failed) for
# those projects. Projects WITH an external database_config route there instead.
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_ENDPOINT=
POSTGRES_PORT=
POSTGRES_DATABASE=

# ── Per-project config decryption (REQUIRED) ──
# Must match the frontend's ENCRYPTION_MASTER_KEY, or external connections
# cannot be decrypted and every project falls back to defaults.
ENCRYPTION_MASTER_KEY=

# ── Default Qdrant ──
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=
QDRANT_PORT=

# ── Default S3 / MinIO ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
MINIO_URL=

# ── Default embedding ──
EMBEDDING_MODEL=
EMBEDDING_API_BASE=
NCSA_HOSTED_API_KEY=
OLLAMA_SERVER_URL=
ALLOWED_EMBEDDING_PROVIDERS=

# ── Optional ──
POSTHOG_API_KEY=
CANVAS_ACCESS_TOKEN=
