# ---------------------------------------------------------------------------
# RabbitMQ ingest worker environment template.
#
# The worker (worker.py) and producer (rmqueue.py) call load_dotenv(), so a
# `.env` in this directory is picked up when running `python worker.py` from
# ai_ta_backend/rabbitmq/. Copy this file to `.env` and fill in real values
# (the `.env` is gitignored). In Docker, pass these via `env_file:` in
# docker-compose.yml — note the existing compose `POSTGRES_HOST/DB/USER` keys
# are NOT read by the code (it reads POSTGRES_ENDPOINT/DATABASE/USERNAME).
#
# These are the DEFAULTS used when a project has no external connection
# configured in `project_external_connections`. Per-project overrides
# (bucket / qdrant / database / embedding) are resolved at runtime and take
# precedence over everything below.
# ---------------------------------------------------------------------------

# ── RabbitMQ ──
RABBITMQ_URL=                      # e.g. amqp://uiuc-chat-dev:password@localhost:5672
RABBITMQ_QUEUE=uiuc-chat
RABBITMQ_SSL=false                 # true only for AWS AmazonMQ (TLS)
RABBITMQ_PREFETCH_COUNT=1
MAX_JOB_RETRIES=10

# ── Host documents DB (default for projects without database_config) ──
# Also holds ingest status (documents_in_progress / documents_failed) for
# those projects. Projects WITH an external database_config route there instead.
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_ENDPOINT=
POSTGRES_PORT=
POSTGRES_DATABASE=

# ── Per-project config decryption (REQUIRED) ──
# Must match the frontend's ENCRYPTION_MASTER_KEY. Without it, external
# connections cannot be decrypted and every project falls back to defaults.
ENCRYPTION_MASTER_KEY=

# ── Default Qdrant ──
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=
QDRANT_PORT=

# ── Default S3 / MinIO ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
MINIO_URL=                         # S3 endpoint_url; leave blank for AWS S3

# ── Default embedding ──
# openai-compatible default; provider=ollama projects use OLLAMA_SERVER_URL
# (or their per-project base_url). ALLOWED_EMBEDDING_PROVIDERS gates which
# providers a project may configure.
EMBEDDING_MODEL=
EMBEDDING_API_BASE=                # base URL; the worker appends /embeddings
NCSA_HOSTED_API_KEY=
OPENAI_API_KEY=                    # optional; falls back to NCSA_HOSTED_API_KEY
OLLAMA_SERVER_URL=
ALLOWED_EMBEDDING_PROVIDERS=openai,ollama

# ── Optional / tuning ──
POSTHOG_API_KEY=
CANVAS_ACCESS_TOKEN=
QDRANT_UPSERT_BATCH_SIZE=100
EMBEDDING_MAX_ATTEMPTS=10
